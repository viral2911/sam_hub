{
  "mcpServers": {
    "mariadb-210": {
      "command": "py",
      "args": ["-m", "mysql_mcp_server"],
      "env": {
        "MYSQL_HOST": "${MYSQL_HOST}",
        "MYSQL_PORT": "${MYSQL_PORT}",
        "MYSQL_USER": "${MYSQL_USER}",
        "MYSQL_PASSWORD": "${MYSQL_PASSWORD}",
        "MYSQL_DATABASE": "${MYSQL_DATABASE}"
      }
    },
    "sql-123-mis": {
      "command": "dotnet",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/.claude/mcp-tools/mssql-mcp/publish/MSSQL.MCP.dll"],
      "env": {
        "MSSQL_CONNECTION_STRING": "${MSSQL_MIS_CONNECTION_STRING}"
      }
    },
